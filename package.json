{
	"name": "y-el-dolar-che",
	"version": "3.1.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build --delete-output-path && npm run build:background && npm run postbuild && npm run check",
		"postbuild": "node scripts/prune-package.mjs",
		"check": "node scripts/check-manifest.mjs",
		"package": "npm run build && powershell -NoProfile -Command \"Compress-Archive -Path dist/* -DestinationPath dist.zip -Force\"",
		"watch": "ng build --delete-output-path --watch --configuration development",
		"test": "ng test",
		"test:ci": "ng test --watch=false --browsers=ChromeHeadless",
		"lint": "ng lint",
		"build:background": "node scripts/build-background.mjs"
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^20.3.35",
		"@angular/compiler": "^20.3.35",
		"@angular/core": "^20.3.35",
		"@angular/forms": "^20.3.35",
		"@angular/platform-browser": "^20.3.35",
		"@angular/platform-browser-dynamic": "^20.3.35",
		"@angular/router": "^20.3.35",
		"primeicons": "^7.0.0",
		"rxjs": "^7.8.1",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.1"
	},
	"devDependencies": {
		"@angular-eslint/builder": "^20.7.0",
		"@angular-eslint/eslint-plugin": "^20.7.0",
		"@angular-eslint/eslint-plugin-template": "^20.7.0",
		"@angular-eslint/schematics": "^20.7.0",
		"@angular-eslint/template-parser": "^20.7.0",
		"@angular/build": "^20.3.43",
		"@angular/cli": "~20.3.43",
		"@angular/compiler-cli": "^20.3.35",
		"@types/chrome": "^0.3.7",
		"@types/jasmine": "^5.1.15",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"esbuild": "^0.25.2",
		"eslint": "^8.17.0",
		"jasmine-core": "^5.13.0",
		"karma": "^6.4.4",
		"karma-chrome-launcher": "^3.2.0",
		"karma-coverage": "^2.2.1",
		"karma-jasmine": "^5.1.0",
		"karma-jasmine-html-reporter": "^2.3.0",
		"prettier": "2.7.1",
		"typescript": "~5.8.3"
	}
}
