{
	"name": "y-el-dolar-che",
	"version": "3.2.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build --delete-output-path && npm run build:background && npm run postbuild && npm run check",
		"icons": "node scripts/make-icons.mjs",
		"postbuild": "node scripts/prune-package.mjs",
		"check": "node scripts/check-manifest.mjs",
		"package": "npm run build && powershell -NoProfile -Command \"Compress-Archive -Path dist/* -DestinationPath dist.zip -Force\"",
		"watch": "ng build --delete-output-path --watch --configuration development",
		"test": "ng test",
		"test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
		"lint": "ng lint",
		"format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/*.mjs\" \"*.{json,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/*.mjs\" \"*.{json,md}\"",
		"build:background": "node scripts/build-background.mjs",
		"preview": "node scripts/preview.mjs",
		"preview:shot": "node scripts/preview.mjs --shot",
		"shots:store": "node scripts/store-shots.mjs"
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^22.3.0",
		"@angular/compiler": "^22.3.0",
		"@angular/core": "^22.3.0",
		"@angular/forms": "^22.3.0",
		"@angular/platform-browser": "^22.3.0",
		"@angular/platform-browser-dynamic": "^22.3.0",
		"primeicons": "^7.0.0",
		"rxjs": "^7.8.1",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.1"
	},
	"devDependencies": {
		"@angular-eslint/builder": "^22.8.0",
		"@angular-eslint/eslint-plugin": "^22.8.0",
		"@angular-eslint/eslint-plugin-template": "^22.8.0",
		"@angular-eslint/schematics": "^22.8.0",
		"@angular-eslint/template-parser": "^22.8.0",
		"@angular/build": "^22.3.0",
		"@angular/cli": "~22.3.0",
		"@angular/compiler-cli": "^22.3.0",
		"@eslint/js": "^10.0.1",
		"@types/chrome": "^0.3.7",
		"@types/jasmine": "^5.1.15",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"angular-eslint": "^22.8.0",
		"esbuild": "^0.25.2",
		"eslint": "^10.15.0",
		"istanbul-lib-instrument": "^6.0.3",
		"jasmine-core": "^5.13.0",
		"karma": "^6.4.4",
		"karma-chrome-launcher": "^3.2.0",
		"karma-coverage": "^2.2.1",
		"karma-jasmine": "^5.1.0",
		"karma-jasmine-html-reporter": "^2.3.0",
		"prettier": "^3.10.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0"
	}
}
