{
	"name": "__MSG_appName__",
	"description": "__MSG_appDesc__",
	"version": "3.1.0",
	"manifest_version": 3,
	"icons": {
		"16": "assets/img/icon.png",
		"32": "assets/img/icon.png",
		"48": "assets/img/icon.png"
	},
	"host_permissions": [
		"https://dolarapi.com/*",
		"https://api.argentinadatos.com/*"
	],
	"permissions": [
		"alarms",
		"storage",
		"notifications",
		"contextMenus"
	],
	"action": {
		"default_popup": "index.html",
		"default_icon": {
			"16": "assets/img/icon.png",
			"32": "assets/img/icon.png",
			"48": "assets/img/icon.png"
		},
		"default_title": "__MSG_appName__"
	},
	"default_locale": "es",
	"background": {
		"service_worker": "background.js"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+D"
			},
			"description": "__MSG_command_open_popup__"
		}
	}
}
